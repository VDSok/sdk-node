{
  "name": "@vdsok/sdk",
  "version": "1.0.0",
  "description": "Official Node.js / TypeScript SDK for the VDSok Client API v1 (servers, domains, balance, invoices, webhooks).",
  "keywords": ["vdsok", "vds", "vps", "hosting", "api", "sdk", "domains", "billing"],
  "homepage": "https://github.com/VDSok/sdk-node#readme",
  "bugs": {
    "url": "https://github.com/VDSok/sdk-node/issues",
    "email": "support@vdsok.guru"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VDSok/sdk-node.git"
  },
  "license": "MIT",
  "author": "VDSok <support@vdsok.guru> (https://vdsok.guru)",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "gen": "node scripts/gen.mjs",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.14.0",
    "openapi-typescript": "^7.4.0",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0",
    "yaml": "^2.5.0"
  }
}
